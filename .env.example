# Local: npm run dev. Change BACKEND_PORT if another app uses 8000.
BACKEND_PORT=8000
HOST=127.0.0.1
# Production: NODE_ENV=production, HOST=0.0.0.0, Render supplies PORT.
NODE_ENV=development
# Production only: >=32 random characters. Never expose this as a PUBLIC_* variable.
ADMIN_TOKEN=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,capacitor://localhost,https://localhost
# Set these on Vercel (build-time) AND Render (runtime), using your actual host URLs.
PUBLIC_API_URL=
PUBLIC_WS_URL=
PUBLIC_MOBILE_URL=
